# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Server-only: required for webhook handling and AI quota enforcement. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# AI providers (server-side only; never expose these as VITE_ variables)
GROQ_API_KEY=
GEMINI_API_KEY=

# Paddle
# Browser-safe Paddle client token. Use a test_ token for sandbox and a live token for production.
VITE_PAYMENTS_CLIENT_TOKEN=
PADDLE_SANDBOX_API_KEY=
PADDLE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# Server configuration
AI_ENABLED=true
# Per-user, per-day server-side cap. Valid range: 1-500.
AI_DAILY_REQUEST_LIMIT=50
# Bearer secret for scheduled server routes; keep the previous value only during rotation.
GYMSLIFE_CRON_SECRET=
GYMSLIFE_CRON_SECRET_PREVIOUS=
